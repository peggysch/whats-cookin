<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Informatics.MauiSurdeg.Pages.DepartmentsPage"
             Title="Departments">
    <VerticalStackLayout Padding="15"
            Spacing="10">
        <!-- Add Department Button -->
        <Button Text="Add Department"
                Command="{Binding OpenAddDepartmentCommand}"
                HorizontalOptions="Fill"
                BackgroundColor="#27AE60"
                TextColor="White"
                FontAttributes="Bold"
                Padding="12"/>
        <!-- CollectionView for Department List -->
        <CollectionView x:Name="DepartmentsList"
                        ItemsSource="{Binding Departments}"
                        SelectionMode="None"
                        VerticalOptions="FillAndExpand"
                        ItemsUpdatingScrollMode="KeepItemsInView">
            <!-- Template for each department item -->
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="#E0E0E0"
                            StrokeThickness="1"
                            Padding="10"
                            Margin="5">
                        <Grid ColumnDefinitions="*,Auto"
                                RowDefinitions="Auto,Auto">
                            <!-- Department Name -->
                            <Label Grid.Row="0"
                                    Grid.Column="0"
                                   Text="{Binding Name}"
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   AutomationId="DepartmentName"
                                   TextColor="Black"/>
                            <!-- Department Budget -->
                            <Label Grid.Row="1"
                                    Grid.Column="0"
                                   Text="{Binding Budget, StringFormat='Budget: {0:C}'}"
                                   FontSize="16"
                                   AutomationId="DepartmentBudget"
                                   TextColor="Gray"/>
                            <!-- Tap Gesture for Selecting Department -->
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Path=BindingContext.OpenDepartmentDetailsCommand, Source={x:Reference DepartmentsList}}"
                                                      CommandParameter="{Binding Id}"/>
                            </Grid.GestureRecognizers>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <!-- Empty View -->
            <CollectionView.EmptyView>
                <Label Text="No departments found."
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       FontSize="16"
                       FontAttributes="Italic"
                       TextColor="Gray"/>
            </CollectionView.EmptyView>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>