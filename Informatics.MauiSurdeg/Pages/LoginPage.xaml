<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Informatics.MauiSurdeg.Pages.LoginPage"
             Title="Login">

    <VerticalStackLayout Padding="30" Spacing="15"
                         VerticalOptions="Center"
                         HorizontalOptions="Center">
        
        <Label Text="What's Cookin'"
               FontFamily="LibreBaskerville-Bold.ttf#LibreBaskervilleBold"
               FontSize="40"
               FontAttributes="Bold"
               HorizontalOptions="Center"/>
       
        <Label Text="Create an account"
               FontFamily="LibreBaskerville-Bold.ttf#LibreBaskervilleBold"
               FontSize="28"
               FontAttributes="Bold"
               HorizontalOptions="Center"/>
       
        <Label Text="Enter a username and password"
               FontFamily="LibreBaskerville-Regular.ttf#LibreBaskervilleRegular"
               TextColor="#FF787474"
               FontSize="20"
               HorizontalOptions="Center"/>

        <Entry Placeholder="user123"
               Text="{Binding newUsername}"
               Keyboard="Text"
               WidthRequest="250"/>

        <Entry Placeholder="password123"
               Text="{Binding newPassword}"
               IsPassword="True"
               WidthRequest="250"/>

        <Button Text="Create account"
                FontFamily="LibreBaskerville-Regular.ttf#LibreBaskervilleRegular"
                Command="{Binding LoginCommand}"
                BackgroundColor="#FF51A888"
                TextColor="White"
                CornerRadius="10"
                WidthRequest="250"/>
        
        <Label Text="Already have an account?"
               FontFamily="LibreBaskerville-Regular.ttf#LibreBaskervilleRegular"
               TextColor="#FF787474"
               FontSize="20"
               HorizontalOptions="Center"/>

        <Entry Placeholder="Username"
               Text="{Binding Username}"
               Keyboard="Text"
               WidthRequest="250"/>

        <Entry Placeholder="Password"
               Text="{Binding Password}"
               IsPassword="True"
               WidthRequest="250"/>

        <Button Text="Log In"
                Command="{Binding LoginCommand}"
                BackgroundColor="#FF51A888"
                FontFamily="LibreBaskerville-Regular.ttf#LibreBaskervilleRegular"
                TextColor="White"
                CornerRadius="10"
                WidthRequest="250"/>
        
        <!-- Display Error Message -->
        <Label Text="{Binding ErrorMessage}"
               TextColor="Red"
               FontSize="14"
               HorizontalOptions="Center"/>
    </VerticalStackLayout>
</ContentPage>
