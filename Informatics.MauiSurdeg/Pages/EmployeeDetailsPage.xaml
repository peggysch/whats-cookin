<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Informatics.MauiSurdeg.Pages.EmployeeDetailsPage"
             Title="Employee Details"
             BackgroundColor="White">
    <ScrollView>
        <VerticalStackLayout Spacing="15"
                             Padding="20">
            <!-- Employee Details Section -->
            <Border Stroke="#E0E0E0"
                    StrokeThickness="1"
                    Padding="15"
                    Margin="0,0,0,10">
                <VerticalStackLayout Spacing="12">
                    <!-- Employee Number -->
                    <Label Text="Employee Number:"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="Black"/>
                    <Entry Text="{Binding Employee.Number, Mode=TwoWay}"
                           Placeholder="Enter employee number"
                           FontSize="16"
                           TextColor="Black"
                           BackgroundColor="#F7F7F7"/>
                    <!-- Employee Name -->
                    <Label Text="Name:"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="Black"/>
                    <Entry Text="{Binding Employee.Name, Mode=TwoWay}"
                           Placeholder="Enter name"
                           FontSize="16"
                           TextColor="Black"
                           BackgroundColor="#F7F7F7"/>
                    <!-- Employee Salary -->
                    <Label Text="Salary:"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="Black"/>
                    <Entry Text="{Binding Employee.Salary, StringFormat='{0:F2}', Mode=TwoWay}"
                           Keyboard="Numeric"
                           Placeholder="Enter salary"
                           FontSize="16"
                           TextColor="Black"
                           BackgroundColor="#F7F7F7"/>
                    <!-- Current Department -->
                    <Label Text="Current Department:"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="Black"/>
                    <Entry Text="{Binding Employee.Department.Name, Mode=TwoWay}"
                           IsReadOnly="True"
                           FontSize="16"
                           BackgroundColor="#F0F0F0"
                           TextColor="Gray"/>
                    <Picker x:Name="DepartmentPicker"
                            ItemsSource="{Binding Departments}"
                            SelectedItem="{Binding Employee.Department, Mode=TwoWay}"
                            ItemDisplayBinding="{Binding Name}"
                            HorizontalOptions="Fill"/>
                </VerticalStackLayout>
            </Border>
            <!-- Save Changes Button -->
            <Button Text="Save Changes"
                    Command="{Binding SaveEmployeeCommand}"
                    BackgroundColor="#4A90E2"
                    TextColor="White"
                    FontAttributes="Bold"
                    Padding="12"/>
            <!-- Delete Button -->
            <Button Text="Delete"
                    Command="{Binding DeleteEmployeeCommand}"
                    BackgroundColor="#E74C3C"
                    TextColor="White"
                    FontAttributes="Bold"
                    Padding="12"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>