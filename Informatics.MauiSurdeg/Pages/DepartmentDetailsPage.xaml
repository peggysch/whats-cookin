<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Informatics.MauiSurdeg.Pages.DepartmentDetailsPage"
             Title="Department Details"
             BackgroundColor="White">
    <ScrollView>
        <VerticalStackLayout Spacing="15"
                Padding="20">
            <!-- Department Details Section -->
            <Border Stroke="#E0E0E0"
                    StrokeThickness="1"
                    Padding="15"
                    Margin="0,0,0,10">
                <VerticalStackLayout Spacing="12">
                    <!-- Department Name -->
                    <Label Text="Department Name:"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="Black"/>
                    <Entry Text="{Binding Department.Name, Mode=TwoWay}"
                           Placeholder="Enter department name"
                           FontSize="16"
                           TextColor="Black"
                           BackgroundColor="#F7F7F7"/>
                    <!-- Department Budget -->
                    <Label Text="Budget:"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="Black"/>
                    <Entry Text="{Binding Department.Budget, StringFormat='{0:F2}', Mode=TwoWay}"
                           Keyboard="Numeric"
                           Placeholder="Enter budget"
                           FontSize="16"
                           TextColor="Black"
                           BackgroundColor="#F7F7F7"/>
                </VerticalStackLayout>
            </Border>
            <!-- Save Changes Button -->
            <Button Text="Save Changes"
                    Command="{Binding SaveDepartmentCommand}"
                    BackgroundColor="#4A90E2"
                    TextColor="White"
                    FontAttributes="Bold"
                    Padding="12"/>
            <!-- Delete Button -->
            <Button Text="Delete"
                    Command="{Binding DeleteDepartmentCommand}"
                    BackgroundColor="#E74C3C"
                    TextColor="White"
                    FontAttributes="Bold"
                    Padding="12"/>
            <!-- Employee List (Read-Only) -->
            <Label Text="Employees in this Department:"
                   FontAttributes="Bold"
                   FontSize="16"
                   TextColor="Black"/>
            <CollectionView ItemsSource="{Binding Department.Employees}"
                            SelectionMode="None"
                            VerticalOptions="FillAndExpand"
                            ItemsUpdatingScrollMode="KeepItemsInView">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="#E0E0E0"
                                StrokeThickness="1"
                                Padding="10"
                                Margin="5">
                            <Grid ColumnDefinitions="*,Auto"
                                    RowDefinitions="Auto">
                                <Label Grid.Row="0"
                                        Grid.Column="0"
                                       Text="{Binding Name}"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       TextColor="Black"/>
                                <Label Grid.Row="0"
                                        Grid.Column="1"
                                       Text="{Binding Salary, StringFormat='Salary: {0:C}'}"
                                       FontSize="14"
                                       TextColor="Gray"
                                       HorizontalOptions="End"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <!-- Empty View -->
                <CollectionView.EmptyView>
                    <Label Text="No employees found in this department."
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           FontSize="14"
                           FontAttributes="Italic"
                           TextColor="Gray"/>
                </CollectionView.EmptyView>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>