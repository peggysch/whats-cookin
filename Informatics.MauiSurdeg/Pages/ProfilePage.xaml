<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Informatics.MauiSurdeg.Pages.ProfilePage"
             Title="Your Profile">
  
    <ScrollView>
        <StackLayout Padding="20">
            
            <!-- Username -->
            <Label Text="Your Profile"
                   FontSize="24"
                   FontAttributes="Bold"/>
            <Label Text="{Binding Username}"
                   FontSize="20"
                   TextColor="Black"/>

            <!-- Recipe Section -->
            <Label Text="Recipes:"
                   FontSize="20"
                   FontAttributes="Bold"
                   Margin="0,10,0,5"/>
            
            <CollectionView ItemsSource="{Binding Recipes}" HorizontalScrollBarVisibility="Never">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="5" Margin="5" CornerRadius="10" HasShadow="True">
                            <StackLayout>
                                <Image Source="{Binding ImageUrl}" HeightRequest="100" WidthRequest="100"/>
                                <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold"/>
                                <Label Text="{Binding Rating, StringFormat='{0}/5 ★'}" FontSize="14"/>
                                <Label Text="{Binding Date, StringFormat='{0:dd MMM yyyy}'}" FontSize="12"/>
                            </StackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Click on a recipe to edit" FontSize="16" Margin="0,10,0,5"/>
            
            <!-- Selected Recipe Details -->
            <Frame Padding="15" BackgroundColor="#F5F5F5" CornerRadius="10">
                <StackLayout>
                    <Label Text="{Binding SelectedRecipe.Name}" FontSize="18" FontAttributes="Bold"/>
                    <Label Text="{Binding SelectedRecipe.Date, StringFormat='dd MMM - k. HH:mm'}" FontSize="12"/>
                    <Label Text="{Binding SelectedRecipe.Description}" FontSize="14"/>
                    
                    <Label Text="Ingredients:" FontSize="16" FontAttributes="Bold" Margin="0,10,0,2"/>
                    <Label Text="{Binding SelectedRecipe.Ingredients}" FontSize="14"/>
                    
                    <StackLayout Orientation="Horizontal" Spacing="20" Margin="0,10,0,5">
                        <Label Text="Time" FontSize="14" FontAttributes="Bold"/>
                        <Label Text="{Binding SelectedRecipe.Time, StringFormat='{0} min'}" FontSize="14"/>
                        <Label Text="Cost/portion" FontSize="14" FontAttributes="Bold"/>
                        <Label Text="{Binding SelectedRecipe.Cost, StringFormat='{0} kr'}" FontSize="14"/>
                    </StackLayout>

                    <StackLayout Orientation="Horizontal" Spacing="10">
                        <Button Text="Edit Recipe"
                                BackgroundColor="Green"
                                TextColor="White"
                                Command="{Binding EditRecipeCommand}"/>
                        
                        <Button Text="Delete Recipe"
                                BackgroundColor="Red"
                                TextColor="White"
                                Command="{Binding DeleteRecipeCommand}"/>
                    </StackLayout>

                </StackLayout>
            </Frame>

        </StackLayout>
    </ScrollView>
</ContentPage>
