<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Informatics.MauiSurdeg.Pages.ProfilePage"
             Title="Profile"
             xmlns:local="clr-namespace:Informatics.MauiSurdeg.ViewModels"
             NavigationPage.HasBackButton="False">

        <Grid RowDefinitions="Auto, Auto, *, Auto">
                <!-- Username -->
                <Label Text="Your Profile"
                       FontSize="24"
                       FontAttributes="Bold"
                       Padding="10"
                       HorizontalOptions="Center"/>

                <Label Text="{Binding Username}"
                       FontSize="20"
                       FontAttributes="Bold"
                       Padding="10"
                       Grid.Row="1"
                       HorizontalOptions="Center"/>

                <!-- List of User Recipes -->
                <ScrollView Grid.Row="2"
                            HeightRequest="250"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                        <CollectionView ItemsSource="{Binding UserRecipes}"
                                        SelectionMode="Single"
                                        SelectedItem="{Binding SelectedRecipe, Mode=TwoWay}"
                                        HorizontalOptions="Center">
                                <CollectionView.ItemsLayout>
                                        <LinearItemsLayout Orientation="Vertical"/>
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                                <Frame Padding="20"
                                                       Margin="5"
                                                       BackgroundColor="White"
                                                       BorderColor="Gray">
                                                        <StackLayout HorizontalOptions="Center">
                                                                <Label Text="{Binding RecipeName}"
                                                                       FontSize="16"
                                                                       HorizontalOptions="Center"/>
                                                                <Label Text="{Binding CreatedAt, StringFormat='{0:dd MMM yyyy}'}"
                                                                       FontSize="12"
                                                                       HorizontalOptions="Center"/>
                                                                <Label Text="{Binding CookingTime, StringFormat='{0} min'}"
                                                                       FontSize="14"
                                                                       HorizontalOptions="Center"/>
                                                                <Label Text="{Binding Ratings.Count, StringFormat='{0} Ratings'}"
                                                                       FontSize="12"
                                                                       HorizontalOptions="Center"/>
                                                        </StackLayout>
                                                </Frame>
                                        </DataTemplate>
                                </CollectionView.ItemTemplate>
                        </CollectionView>
                </ScrollView>

                <!-- Selected Recipe Details (Fixed Position, Not Overlapping) -->
                <Border Grid.Row="3"
                        Padding="10"
                        Margin="10">
                        <StackLayout>
                                <Label Text="Selected Reciep Details"
                                       FontSize="18"
                                       FontAttributes="Bold"/>
                                <!-- Titel -->
                                <Entry Text="{Binding SelectedRecipe.RecipeName, Mode=TwoWay}"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"/>
                                <!-- Datum -->
                                <Label Text="Date"/>
                                <DatePicker Date="{Binding SelectedRecipe.CreatedAt, Mode=TwoWay}"
                                            Format="dd MMM yyyy"
                                            MinimumDate="2000-01-01"
                                            MaximumDate="{Binding MaxDate}"
                                            FontSize="14"
                                            HorizontalOptions="Center"/>
                                <!-- beskrivning -->
                                <Label Text="Description"/>
                                <Editor Text="{Binding SelectedRecipe.RecipeDescription}"
                                        FontSize="14"
                                        BackgroundColor="#FF8DB6AC"
                                        TextColor="White"/>
                                <!-- Ingridienser -->
                                <Label Text="Ingredients:"
                                       FontSize="16"
                                       FontAttributes="Bold"/>
                                <Label Text="{Binding RecipeIngredients.Count, StringFormat='Antal ingredienser: {0}'}"/>
                                
                                <CollectionView ItemsSource="{Binding RecipeIngredients}"
                                                HeightRequest="200"
                                                SelectionMode="None">
                                        <CollectionView.ItemTemplate>
                                                <DataTemplate>
                                                        <Grid ColumnDefinitions="100, *, 50"
                                                              Padding="5">
                                                                <!-- Ingrediensens namn -->
                                                                <Label Grid.Column="1"
                                                                       Text="{Binding Ingredient.IngredientName}"
                                                                       FontSize="14"
                                                                       FontFamily="LibreBaskerville-Regular.ttf#LibreBaskervilleRegular"
                                                                       VerticalOptions="Center"/>

                                                                <!-- Mängd (redigerbar) -->
                                                                <Entry Grid.Column="0"
                                                                       Text="{Binding Quantity, Mode=TwoWay}"
                                                                       FontSize="14"
                                                                       Keyboard="Numeric"
                                                                       BackgroundColor="#FF8DB6AC"
                                                                       TextColor="White"/>
                                                        </Grid>
                                                </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                </CollectionView>


                                <!-- Lägg till ingrediens -->
                                <Label Text="Add New Ingredient:"
                                                FontSize="16"
                                                FontAttributes="Bold"/>

                                <HorizontalStackLayout Spacing="20">
                                        <Picker ItemsSource="{Binding AvailableIngredients}"
                                                ItemDisplayBinding="{Binding IngredientName}"
                                                SelectedItem="{Binding SelectedIngredient}"
                                                WidthRequest="370"
                                                BackgroundColor="#FF8DB6AC"/>

                                        <Entry Text="{Binding NewIngredientQuantity}"
                                               Placeholder="Quantity"
                                               WidthRequest="150"
                                               Keyboard="Numeric"
                                               BackgroundColor="#FF8DB6AC"/>

                                        <Button Text="Add Ingredient"
                                                BackgroundColor="#FF306356"
                                                TextColor="White"
                                                CornerRadius="10"
                                                WidthRequest="200"
                                                Command="{Binding AddIngredientCommand}"
                                                FontFamily="LibreBaskerville-Regular.ttf#LibreBaskervilleRegular"
                                                IsEnabled="{Binding IsRecipeSelected}"/>
                                </HorizontalStackLayout>

                                <!-- Tid -->
                                <Label Text="Time"
                                       FontSize="16"
                                       FontAttributes="Bold"/>
                                <Entry Text="{Binding SelectedRecipe.CookingTime, Mode=TwoWay}"
                                       FontSize="14"
                                       Keyboard="Numeric"/>

                                <!-- Rating -->
                                <Label Text="Ratings"
                                       FontSize="16"
                                       FontAttributes="Bold"/>
                                <Label Text="{Binding SelectedRecipe.Ratings.Count, StringFormat='{0} Ratings'}"
                                       FontSize="14"/>

                                <Button Text="Edit Recipe"
                                        Command="{Binding EditRecipeCommand}"
                                        BackgroundColor="#FF51A888"
                                        CornerRadius="8"
                                        WidthRequest="180"
                                        HorizontalOptions="Center"
                                        IsEnabled="{Binding IsRecipeSelected}"/>

                                <Button Text="Delete Recipe"
                                        Command="{Binding DeleteRecipeCommand}"
                                        BackgroundColor="#FFC56B6B"
                                        CornerRadius="8"
                                        WidthRequest="180"
                                        HorizontalOptions="Center"
                                        IsEnabled="{Binding IsRecipeSelected}">

                                </Button>
                        </StackLayout>
                </Border>
        </Grid>
</ContentPage>
