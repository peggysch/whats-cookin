<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Informatics.MauiSurdeg.Pages.ProfilePage"
             Title="ProfilePage">
    <VerticalStackLayout Padding="15" Spacing="10">
        <!--Rubrik med användarnamn-->
        <Label 
            Text="{binding Usernamw}"
            FontSize ="24" 
            FontAttributes="Bold"
            HorizontalOptions="Center" />
        <!-- Lista över användarens recept -->
        <CollectionView ItemSource="{Binding UserRecipe}"
            SeelctionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="10" ColumnDefinitions="Auto,*,Auto"
                        RowDefinitions="Auto,Auto">

                        <!-- Receptbild -->
                        <Image Grid.Row="0" Grid.Column="0"
                               Source="{Binding ImageUrl}"
                               HeightRequest="80"
                               WidthRequest="80"
                               Aspect="AspectFill"/>
                        
                        <!-- Receptinfo -->
                        <VerticalStackLayout Grid.Row="0" Grid.Column="1"
                                             Padding="10">
                            <Label Text="{Binding Title}" FontSize="18" FontAttributes="Bold"/>
                            <Label Text="{Binding CreatedAt, StringFormat='{0:dd MMM yyyy}'}"/>
                            <Label Text="⭐ {Binding AverageRating}" FontSize="16"/>
                        </VerticalStackLayout>

                        <!-- Redigera & radera-knappar -->
                        <HorizontalStackLayout Grid.Row="0" Grid.Column="2">
                            <Button Text="✏️"
                                    Command="{Binding Path=BindingContext.EditRecipeCommand, Source={x:Reference CollectionView}}"
                                    CommandParameter="{Binding .}"
                                    Padding="5"/>
                            <Button Text="🗑️"
                                    Command="{Binding Path=BindingContext.DeleteRecipeCommand, Source={x:Reference CollectionView}}"
                                    CommandParameter="{Binding .}"
                                    Padding="5"
                                    BackgroundColor="Red"
                                    TextColor="White"/>
                        </HorizontalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        
        <!-- Område för att redigera ett recept -->
        <Frame IsVisible="{Binding IsEditingRecipe}" Padding="10" BorderColor="Gray">
            <VerticalStackLayout>
                <Label Text="Edit Recipe" FontSize="20" FontAttributes="Bold"/>
                <Entry Placeholder="Recipe Title" Text="{Binding SelectedRecipe.Title}" />
                <Editor Placeholder="Description" Text="{Binding SelectedRecipe.Description}"/>
                <Button Text="Save Changes" Command="{Binding SaveRecipeCommand}" />
            </VerticalStackLayout>
        </Frame>

    </VerticalStackLayout>
</ContentPage>