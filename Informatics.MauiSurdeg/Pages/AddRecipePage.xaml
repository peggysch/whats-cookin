<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Informatics.MauiSurdeg.Pages.AddRecipePage"
             x:Name="AddRecipePageInstance"
             Title="Add Recipe"
             BackgroundColor="White">

       <AbsoluteLayout>
              <VerticalStackLayout AbsoluteLayout.LayoutBounds="0.5,0.5,-1,-1"
                                   AbsoluteLayout.LayoutFlags="None"
                                   Padding="20"
                                   Spacing="10"
                                   BackgroundColor="WhiteSmoke">

                     <!-- Recipe Name -->
                     <Label Text="Enter Recipe Name:"
                            FontFamily="LibreBaskerville-Bold.ttf#LibreBaskervilleBold"/>
                     <Entry Text="{Binding RecipeName}"
                            FontFamily="LibreBaskerville-Regular.ttf#LibreBaskervilleRegular"
                            Placeholder="Ex. Pasta Carbonara"
                            TextColor="Black"
                            WidthRequest="760"
                            HorizontalOptions="Start"
                            BackgroundColor="#FF8DB6AC"/>

                     <!-- Description and Instructions Layout -->
                     <HorizontalStackLayout Spacing="20">
                            <VerticalStackLayout WidthRequest="370">
                                   <Label Text="Enter a short description of your recipe:"
                                          FontFamily="LibreBaskerville-Bold.ttf#LibreBaskervilleBold"/>
                                   <Border Background="#FF8DB6AC"
                                           Padding="1"
                                           HeightRequest="110">
                                          <Border.StrokeShape>
                                                 <RoundRectangle CornerRadius="5"/>
                                          </Border.StrokeShape>
                                          <Editor Text="{Binding RecipeDescription}"
                                                  FontFamily="LibreBaskerville-Regular.ttf#LibreBaskervilleRegular"
                                                  BackgroundColor="#FF8DB6AC"
                                                  TextColor="Black"/>
                                   </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout WidthRequest="370">
                                   <Label Text="Enter a summarized text of instructions:"
                                          FontFamily="LibreBaskerville-Bold.ttf#LibreBaskervilleBold"/>
                                   <Border Background="#FF8DB6AC"
                                           Padding="1"
                                           HeightRequest="110">
                                          <Border.StrokeShape>
                                                 <RoundRectangle CornerRadius="5"/>
                                          </Border.StrokeShape>
                                          <Editor Text="{Binding RecipeInstructions}"
                                                  FontFamily="LibreBaskerville-Regular.ttf#LibreBaskervilleRegular"
                                                  BackgroundColor="#FF8DB6AC"
                                                  TextColor="Black"/>
                                   </Border>
                            </VerticalStackLayout>
                     </HorizontalStackLayout>

                     <!-- Time & Cost -->
                     <HorizontalStackLayout Spacing="20">
                            <VerticalStackLayout WidthRequest="370">
                                   <Label Text="Time (minutes):"
                                          FontFamily="LibreBaskerville-Bold.ttf#LibreBaskervilleBold"/>
                                   <Entry Text="{Binding CookingTimeText, Mode=TwoWay}"
                                          Keyboard="Numeric"
                                          WidthRequest="370"
                                          BackgroundColor="#FF8DB6AC"
                                          TextColor="Black"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout WidthRequest="370">
                                   <Label Text="Cost per portion in SEK:"
                                          FontFamily="LibreBaskerville-Bold.ttf#LibreBaskervilleBold"/>
                                   <Entry Text="{Binding RecipeCostText, Mode=TwoWay}"
                                          Keyboard="Numeric"
                                          WidthRequest="370"
                                          BackgroundColor="#FF8DB6AC"
                                          TextColor="Black"/>
                            </VerticalStackLayout>
                     </HorizontalStackLayout>

                     <!-- Ingredients Section -->
                     <Label Text="Ingredients:"
                            FontFamily="LibreBaskerville-Bold.ttf#LibreBaskervilleBold"/>
                     <HorizontalStackLayout Spacing="20">
                            <Picker ItemsSource="{Binding AvailableIngredients}"
                                    ItemDisplayBinding="{Binding IngredientName}"
                                    SelectedItem="{Binding SelectedIngredient}"
                                    WidthRequest="370"
                                    BackgroundColor="#FF8DB6AC"
                                    FontFamily="LibreBaskerville-Bold.ttf#LibreBaskervilleBold"/>

                            <Entry Text="{Binding IngredientQuantity}"
                                   FontFamily="LibreBaskerville-Regular.ttf#LibreBaskervilleRegular"
                                   Placeholder="Quantity"
                                   WidthRequest="150"
                                   BackgroundColor="#FF8DB6AC"
                                   TextColor="Black"/>

                            <Button Text="Add Ingredient"
                                    BackgroundColor="#FF306356"
                                    TextColor="White"
                                    CornerRadius="10"
                                    WidthRequest="200"
                                    Command="{Binding AddIngredientCommand}"
                                    FontFamily="LibreBaskerville-Regular.ttf#LibreBaskervilleRegular"
                                    HorizontalOptions="Start"/>

                     </HorizontalStackLayout>


                     <!-- Selected Ingredients List -->
                     <Label Text="Selected Ingredients:"
                            FontFamily="LibreBaskerville-Bold.ttf#LibreBaskervilleBold"/>

                     <ScrollView HeightRequest="200">
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding SelectedIngredients}"
                                                 HorizontalOptions="Start"
                                                 Spacing="5">
                                   <BindableLayout.ItemTemplate>
                                          <DataTemplate>
                                                 <Border
                                                        BackgroundColor="#FFE5E6E5"
                                                        Padding="5"
                                                        HorizontalOptions="Fill"
                                                        VerticalOptions="Center">

                                                        <Grid ColumnDefinitions="70, 200, 490">
                                                               <Label Grid.Column="0"
                                                                      Text="{Binding Quantity}"
                                                                      FontFamily="LibreBaskerville-Regular.ttf#LibreBaskervilleRegular"
                                                                      HorizontalOptions="Start"
                                                                      VerticalOptions="Center"
                                                                      TextColor="#5D8D81"/>

                                                               <Label Grid.Column="1"
                                                                      Text="{Binding Ingredient.IngredientName}"
                                                                      FontFamily="LibreBaskerville-Regular.ttf#LibreBaskervilleRegular"
                                                                      VerticalOptions="Center"/>

                                                               <Button Grid.Column="2"
                                                                       Text="Remove"
                                                                       FontFamily="LibreBaskerville-Regular.ttf#LibreBaskervilleRegular"
                                                                       BackgroundColor="#FFF86565"
                                                                       Padding="0"
                                                                       Margin="5,0"
                                                                       TextColor="White"
                                                                       WidthRequest="100"
                                                                       HeightRequest="28"
                                                                       HorizontalOptions="End"
                                                                       VerticalOptions="Center"
                                                                       CornerRadius="8"
                                                                       Command="{Binding BindingContext.RemoveIngredientCommand, Source={x:Reference AddRecipePageInstance}}"
                                                                       CommandParameter="{Binding .}"/>
                                                        </Grid>
                                                 </Border>
                                          </DataTemplate>
                                   </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                     </ScrollView>

                     <!-- Add Recipe Button -->
                     <Button Text="Add Recipe"
                             FontFamily="LibreBaskerville-Regular.ttf#LibreBaskervilleRegular"
                             BackgroundColor="#FF306356"
                             TextColor="White"
                             CornerRadius="10"
                             WidthRequest="200"
                             HorizontalOptions="Center"
                             Command="{Binding SaveRecipeCommand}"/>

              </VerticalStackLayout>
       </AbsoluteLayout>
</ContentPage>
