<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Informatics.MauiSurdeg.Pages.AddRecipePage"
             Title="Add New Recipe">
    
    <VerticalStackLayout Padding="20">
        <Label Text="Enter Recipe Name:" />
        <Entry Text="{Binding RecipeName}" Placeholder="Ex. Pasta Carbonara" />

        <Label Text="Enter a short description:" />
        <Editor Text="{Binding RecipeDescription}" HeightRequest="100"/>

        <Label Text="Instructions:" />
        <Editor Text="{Binding Instructions}" HeightRequest="100"/>

        <Label Text="Time (minutes):" />
        <Entry Text="{Binding CookingTime}" Keyboard="Numeric" />

        <Label Text="Cost per portion in SEK:" />
        <Entry Text="{Binding CostPerPortion}" Keyboard="Numeric" />

        <Label Text="Ingredients:" />
        <Picker ItemsSource="{Binding AvailableIngredients}" 
                ItemDisplayBinding="{Binding IngredientName}" 
                SelectedItem="{Binding SelectedIngredient}" />

        <Entry Text="{Binding IngredientQuantity}" Placeholder="Quantity" />
        <Button Text="Add Ingredient" Command="{Binding AddIngredientCommand}" />

        <Label Text="Selected Ingredients:" />
        <CollectionView ItemsSource="{Binding SelectedIngredients}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <HorizontalStackLayout>
                        <Label Text="{Binding Quantity}" />
                        <Label Text=" " />
                        <Label Text="{Binding Ingredient.IngredientName}" />    
                    </HorizontalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Text="Add Recipe" Command="{Binding SaveRecipeCommand}" />
    </VerticalStackLayout>
</ContentPage>