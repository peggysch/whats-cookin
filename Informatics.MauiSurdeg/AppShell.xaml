<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Informatics.MauiSurdeg.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Informatics.MauiSurdeg"
    Shell.FlyoutBehavior="Disabled"
    Title="Informatics.MauiSurdeg">

    <ShellSection Title="Login">
        <ShellContent ContentTemplate="{DataTemplate local:Pages.LoginPage}" />
    </ShellSection>
    
    <TabBar>
        <ShellSection Title="Recipes">
            <ShellContent ContentTemplate="{DataTemplate local:Pages.AddRecipePage}" />
        </ShellSection>

    </TabBar>
</Shell>